<?xml version="1.0" encoding="utf-8"?>
<!-- Zurück aus dem Player: die Übersicht kommt aus dem Hintergrund wieder nach vorn. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0.4" android:toAlpha="1" android:duration="240" />
    <scale android:fromXScale="1.04" android:toXScale="1" android:fromYScale="1.04" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="240" />
</set>
