<?xml version="1.0" encoding="utf-8"?>
<!-- Die Übersicht tritt beim Öffnen leicht zurück und wird dunkler. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="1" android:toAlpha="0.4" android:duration="260" />
    <scale android:fromXScale="1" android:toXScale="1.04" android:fromYScale="1" android:toYScale="1.04"
        android:pivotX="50%" android:pivotY="50%" android:duration="260" />
</set>
